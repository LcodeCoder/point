{
  "name": "point",
  "version": "0.4.4",
  "author": "Lcode",
  "description": "DeepSeek Harness plugin: the armor-break protocol abstracted from Deva 0.1.15, packaged as a preset mode, with refusal retry, red-team skills and a self-evolution loop (layer attribution, canary, one operator per round, per-round GitHub push).",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./protocol": "./lib/protocol.js",
    "./method": "./lib/method.js",
    "./envelope": "./lib/envelope.js",
    "./package.json": "./package.json",
    "./section": "./lib/section.js",
    "./refusal": "./lib/refusal.js",
    "./evolve": "./lib/evolve/index.js"
  },
  "bin": {
    "point": "lib/cli.js"
  },
  "files": [
    "lib",
    "prompts",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "METHOD.md",
    "LICENSE",
    "skills"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "render": "node lib/cli.js render"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "system-prompt",
    "protocol"
  ],
  "license": "MIT"
}
